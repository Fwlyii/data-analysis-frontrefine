{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "匿名代码测试特征",
  "description": "只包含匿名运行和事件特征，不含问题、回答、代码或个人信息。",
  "type": "object",
  "required": ["schema_version", "runs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "code-test-v1"},
    "runs": {
      "type": "array", "maxItems": 5000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["run_id", "model_id", "task_type", "events"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "model_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "task_type": {"type": "string", "minLength": 1, "maxLength": 100},
          "events": {
            "type": "array", "minItems": 1, "maxItems": 500,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["turn", "event_type"],
              "properties": {
                "turn": {"type": "integer", "minimum": 1},
                "event_type": {"enum": ["test", "edit", "tool", "error"]},
                "test_passed": {"type": ["boolean", "null"]},
                "error_type": {"type": ["string", "null"], "maxLength": 100},
                "output_tokens": {"type": ["integer", "null"], "minimum": 0},
                "duration_seconds": {"type": ["number", "null"], "minimum": 0}
              },
              "allOf": [{"if": {"properties": {"event_type": {"const": "test"}}}, "then": {"required": ["test_passed"], "properties": {"test_passed": {"type": "boolean"}}}, "else": {"properties": {"test_passed": {"type": "null"}}}}]
            },
            "contains": {"properties": {"event_type": {"const": "test"}}, "required": ["event_type"]}
          }
        }
      }
    }
  }
}
