{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Saved CodePromptEval model x prompt conditions. Interval selection coordinates linked anonymous scores and failure rates.",
  "width": 690,
  "height": 280,
  "padding": {
    "left": 8,
    "right": 18,
    "top": 10,
    "bottom": 6
  },
  "data": {
    "name": "conditions"
  },
  "params": [
    {
      "name": "codeBrush",
      "select": {
        "type": "interval",
        "encodings": [
          "x",
          "y"
        ],
        "clear": "dblclick",
        "zoom": false,
        "mark": {
          "fill": "#8958b4",
          "fillOpacity": 0.09,
          "stroke": "#8958b4",
          "strokeWidth": 1.2
        }
      }
    },
    {
      "name": "modelHover",
      "select": {
        "type": "point",
        "fields": [
          "model"
        ],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {
    "type": "point",
    "filled": true,
    "size": 65,
    "stroke": "white",
    "strokeWidth": 0.7,
    "cursor": "pointer"
  },
  "encoding": {
    "x": {
      "field": "tokens",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          700
        ],
        "nice": false
      },
      "axis": {
        "title": "Mean returned output tokens / response",
        "tickCount": 8,
        "grid": false
      }
    },
    "y": {
      "field": "score",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          50
        ],
        "nice": false
      },
      "axis": {
        "title": "Pass@1 (%)",
        "tickCount": 6
      }
    },
    "color": {
      "field": "model_name",
      "type": "nominal",
      "scale": {
        "domain": [
          "DeepSeek Flash",
          "Qwen2.5 7B",
          "Qwen3 8B"
        ],
        "range": [
          "#3978b6",
          "#8958b4",
          "#2c8d83"
        ]
      },
      "legend": {
        "title": null,
        "orient": "top",
        "direction": "horizontal",
        "columns": 3,
        "symbolSize": 70,
        "labelLimit": 140,
        "offset": 20
      }
    },
    "shape": {
      "field": "model_name",
      "type": "nominal",
      "scale": {
        "domain": [
          "DeepSeek Flash",
          "Qwen2.5 7B",
          "Qwen3 8B"
        ],
        "range": [
          "circle",
          "square",
          "triangle-up"
        ]
      },
      "legend": {
        "title": null,
        "orient": "top",
        "direction": "horizontal",
        "columns": 3,
        "symbolSize": 70,
        "labelLimit": 140,
        "offset": 20
      }
    },
    "opacity": {
      "condition": {
        "test": {
          "and": [
            {
              "param": "codeBrush"
            },
            {
              "param": "modelHover"
            }
          ]
        },
        "value": 0.85
      },
      "value": 0.13
    },
    "size": {
      "condition": {
        "param": "modelHover",
        "empty": false,
        "value": 100
      },
      "value": 65
    }
  },
  "config": {
    "font": "Times New Roman",
    "background": "white",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#54545b",
      "titleColor": "#353842",
      "gridColor": "#e8e7ed",
      "gridWidth": 0.6,
      "domainColor": "#8a8a93",
      "tickColor": "#8a8a93",
      "titlePadding": 12,
      "labelPadding": 6
    },
    "legend": {
      "labelFontSize": 13,
      "labelColor": "#353842"
    }
  }
}
